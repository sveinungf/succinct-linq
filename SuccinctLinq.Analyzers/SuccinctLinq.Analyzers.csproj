<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <PolyArgumentExceptions>true</PolyArgumentExceptions>

    <!-- NuGet package -->
    <IsPackable>true</IsPackable>
    <PackageId>SuccinctLinq.Analyzers</PackageId>
    <Version>0.1.0</Version>
    <Authors>sveinungf</Authors>
    <Copyright>Copyright (c) 2026-present Sveinung</Copyright>
    <Description>TODO</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/sveinungf/succinct-linq</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>https://github.com/sveinungf/succinct-linq/releases</PackageReleaseNotes>
    <PackageTags>analyzer</PackageTags>
    <RepositoryUrl>https://github.com/sveinungf/succinct-linq</RepositoryUrl>

    <!-- Analyzer -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Polyfill" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(OutputPath)/$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
    <None Include="../README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
